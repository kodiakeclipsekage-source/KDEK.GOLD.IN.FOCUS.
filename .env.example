HOST=127.0.0.1
PORT=5173
# Local mode only. Set false on any hosted deployment; Firebase ID token then required.
ALLOW_LOCAL_AI=true
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=
AI_TIMEOUT_MS=60000
# Set model IDs available to YOUR account in the settings UI. No automatic fallback.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Server credentials: file outside this repository, or workload identity on your host.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=
# Public web configuration, never service-account credentials or AI API keys.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
