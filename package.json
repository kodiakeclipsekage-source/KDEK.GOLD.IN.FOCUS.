{
  "name": "kodiak-gold-ledger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy:rules": "npx --yes --package=firebase-tools@15.34.1 firebase deploy --only firestore:rules --project kodiak-gold-4a424",
    "predev": "node scripts/prepare-design.mjs",
    "dev": "node --env-file-if-exists=.env server/index.js",
    "prebuild": "node scripts/prepare-design.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js --production",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:rules": "npx --yes --package=firebase-tools@15.34.1 firebase emulators:exec --only firestore --project demo-kodiak \"npm test\""
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "pdfjs-dist": "^6.4.299",
    "vite": "^7.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.56.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
